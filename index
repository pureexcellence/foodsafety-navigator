      summary: "Hoe IFS Logistics naar HACCP en risicoanalyse kijkt.",
      content: "IFS Logistics vereist dat je een gestructureerd systeem hebt gebaseerd op HACCP-principes en risicoanalyse. Dat betekent: een team en verantwoordelijkheden vastleggen, een actuele beschrijving van processen en producten, gevarenanalyse volgens de HACCP-principes, identificatie van CCP’s indien van toepassing, duidelijke procedures en registraties voor beheersmaatregelen, en regelmatige verificatie. Daarnaast vraagt de norm ook aandacht voor food defense en frauderisico’s, afhankelijk van de activiteiten."
    },
    {
      id: "kb-ifs-logistiek-voorbeelden",
      title: "IFS Logistics in de praktijk – voorbeelden voor magazijn",
      topic: "IFS",
      level: "Basis",
      tags: ["praktijk", "magazijn"],
      summary: "Hoe je IFS Logistics vertaalt naar dagelijkse magazijnactiviteiten.",
      content: "Praktische invulling van IFS Logistics in een magazijn kan zijn: duidelijke procedures voor ontvangstcontroles, temperatuurregistratie met alarmen, gedefinieerde criteria voor vrijgave of blokkade, opleidingsplannen voor medewerkers, systematische schoonmaak en ongediertebestrijding, gestructureerde klachten- en incidentenbehandeling, mock recalls en periodieke managementreviews. De norm vraagt niet iets ‘magisch’, maar wel een systematische en aantoonbare aanpak."
    }
  ];

  /******** STATE ********/

  let progress   = loadJson(STORAGE_PROGRESS, {});
  let trainings  = loadJson(STORAGE_TRAINING, []);
  let settings   = loadJson(STORAGE_SETTINGS, {
    brandName: "FoodSafety Navigator",
    brandSub : "HACCP · BVP · FAVV · IFS Logistics – praktijk & compliance",
    apiKey   : "",
    cx       : ""
  });
  let searchStat = loadJson(STORAGE_SEARCHSTAT, { count: 0, lastQuery: "" });

  let activeLessonId = null;
  let searchTopicFilter = "ALL";

  /******** UTIL ********/

  function normalize(str) {
    return (str || "").toString().toLowerCase();
  }

  function getLessonProgress(id) {
    return progress[id] || { doneSteps: [] };
  }

  function setLessonStep(id, index, done) {
    const current = getLessonProgress(id);
    const set = new Set(current.doneSteps);
    if (done) set.add(index); else set.delete(index);
    progress[id] = { doneSteps: Array.from(set) };
    saveJson(STORAGE_PROGRESS, progress);
    renderLessonList();
    renderLessonDetail();
    updateDashboard();
    updateSidebarStats();
  }

  /******** NAVIGATION ********/

  const viewElems    = document.querySelectorAll(".view");
  const navButtons   = document.querySelectorAll(".nav-btn");
  const sidebarStats = document.getElementById("sidebarStats");

  function showView(id) {
    viewElems.forEach(v => v.classList.remove("active"));
    document.getElementById(id).classList.add("active");

    navButtons.forEach(btn => {
      if (btn.dataset.view === id) btn.classList.add("active");
      else btn.classList.remove("active");
    });

    updateSidebarStats();
  }

  navButtons.forEach(btn => {
    btn.addEventListener("click", () => {
      const target = btn.dataset.view;
      if (target) showView(target);
    });
  });

  /******** HACCP-LEERPAD RENDER ********/

  const lessonListEl   = document.getElementById("lessonList");
  const lessonDetailEl = document.getElementById("lessonDetail");

  function renderLessonList() {
    lessonListEl.innerHTML = "";
    LESSONS.forEach(lesson => {
      const prog  = getLessonProgress(lesson.id);
      const total = lesson.steps.length;
      const done  = (prog.doneSteps || []).length;

      let dotClass = "";
      let label    = "Nog niet gestart";
      if (done > 0 && done < total) {
        dotClass = "partial";
        label = `${done}/${total} stappen`;
      } else if (done === total && total > 0) {
        dotClass = "done";
        label = "Volledig afgerond";
      }

      const div = document.createElement("article");
      div.className = "lesson-card" + (lesson.id === activeLessonId ? " active" : "");
      div.innerHTML = `
        <div class="lesson-card-title">${lesson.title}</div>
        <div class="lesson-card-meta">
          <span class="tag topic">${lesson.topic}</span>
          <span class="badge-level">${lesson.level}</span>
          <span>${lesson.duration}</span>
        </div>
        <div class="lesson-card-meta">
          <span class="progress-dot ${dotClass}"></span>
          <span>${label}</span>
        </div>
      `;
      div.addEventListener("click", () => {
        activeLessonId = lesson.id;
        renderLessonList();
        renderLessonDetail();
      });
      lessonListEl.appendChild(div);
    });
  }

  function renderLessonDetail() {
    const lesson = LESSONS.find(l => l.id === activeLessonId);
    if (!lesson) {
      lessonDetailEl.innerHTML = `
        <p class="muted">
          Kies links een les. Je krijgt telkens eerst de theorie in gewone mensentaal, 
          daarna concrete stappen die je kan afvinken.
        </p>`;
      return;
    }

    const prog    = getLessonProgress(lesson.id);
    const doneSet = new Set(prog.doneSteps || []);

    const stepsHtml = lesson.steps.map((step, idx) => `
      <label class="step-check">
        <input type="checkbox" data-step-index="${idx}" ${doneSet.has(idx) ? "checked" : ""}>
        <span>${step}</span>
      </label>
    `).join("");

    lessonDetailEl.innerHTML = `
      <div class="section-title">${lesson.title}</div>
      <div style="display:flex; flex-wrap:wrap; gap:0.35rem; margin-bottom:0.3rem;">
        <span class="tag topic">${lesson.topic}</span>
        <span class="badge-level">${lesson.level}</span>
        <span class="tag">${lesson.duration}</span>
      </div>

      ${lesson.theoryHtml || ""}

      <h4 style="margin:0.45rem 0 0.25rem; font-size:0.9rem;">Praktische toepassing</h4>
      <p class="muted">${lesson.practiceIntro || ""}</p>
      <div>${stepsHtml}</div>

      <div style="display:flex; flex-wrap:wrap; gap:0.55rem; margin-top:0.4rem;">
        <button class="btn" id="btnLessonDone">Markeer les als afgerond</button>
        <button class="btn secondary" id="btnLessonSearch">Extra info opzoeken (optioneel)</button>
      </div>
    `;

    lessonDetailEl.querySelectorAll("input[type='checkbox']").forEach(cb => {
      cb.addEventListener("change", () => {
        const idx = parseInt(cb.dataset.stepIndex, 10);
        setLessonStep(lesson.id, idx, cb.checked);
      });
    });

    const btnDone   = document.getElementById("btnLessonDone");
    const btnSearch = document.getElementById("btnLessonSearch");

    if (btnDone) {
      btnDone.addEventListener("click", () => {
        progress[lesson.id] = { doneSteps: lesson.steps.map((_, i) => i) };
        saveJson(STORAGE_PROGRESS, progress);
        renderLessonList();
        renderLessonDetail();
        updateDashboard();
        updateSidebarStats();
      });
    }

    if (btnSearch) {
      btnSearch.addEventListener("click", () => {
        const searchInput = document.getElementById("searchInput");
        if (searchInput) {
          searchInput.value = `${lesson.topic} ${lesson.title}`;
        }
        showView("view-search");
      });
    }
  }

  /******** SEARCH – INTERNAL ********/

  const searchInputEl     = document.getElementById("searchInput");
  const searchBtnEl       = document.getElementById("searchBtn");
  const internalResultsEl = document.getElementById("internalResults");
  const webResultsEl      = document.getElementById("webResults");
  const searchStatusEl    = document.getElementById("searchStatus");
  const searchMetaEl      = document.getElementById("searchMeta");
  const topicChips        = document.querySelectorAll(".chip");

  topicChips.forEach(chip => {
    chip.addEventListener("click", () => {
      topicChips.forEach(c => c.classList.remove("active"));
      chip.classList.add("active");
      searchTopicFilter = chip.dataset.topic || "ALL";
      updateSearchMeta();
      performSearch(false);
    });
  });

  function updateSearchMeta() {
    let label = "alle domeinen";
    if (searchTopicFilter === "HACCP") label = "HACCP";
    if (searchTopicFilter === "BVP")   label = "BVP / logistiek";
    if (searchTopicFilter === "FAVV")  label = "FAVV / wetgeving";
    if (searchTopicFilter === "IFS")   label = "IFS Logistics";
    searchMetaEl.textContent = `Filter: ${label}`;
  }

  function filterKnowledge(keyword, topicFilter) {
    const q = normalize(keyword);
    return KNOWLEDGE.filter(item => {
      if (topicFilter !== "ALL" && item.topic !== topicFilter) return false;
      if (!q) return true;
      const inTitle   = normalize(item.title).includes(q);
      const inSummary = normalize(item.summary).includes(q);
      const inContent = normalize(item.content).includes(q);
      const inTags    = (item.tags || []).some(t => normalize(t).includes(q));
      return inTitle || inSummary || inContent || inTags;
    });
  }

  function renderInternal(list) {
    if (!list.length) {
      internalResultsEl.innerHTML = `<div class="empty">Geen treffers in de interne kennisbank.</div>`;
      return;
    }
    internalResultsEl.innerHTML = list.map(item => `
      <article class="result-card">
        <div class="result-header">
          <div class="result-title">${item.title}</div>
          <span class="result-badge">${item.topic}</span>
        </div>
        <div class="muted" style="margin-bottom:0.15rem;">
          <span class="badge-level">${item.level}</span>
        </div>
        <div class="result-snippet">${item.summary}</div>
      </article>
    `).join("");
  }

  /******** SEARCH – WEB VIA GOOGLE CSE ********/

  async function fetchWebResults(query) {
    const apiKey = settings.apiKey;
    const cx     = settings.cx;

    if (!apiKey || !cx) {
      webResultsEl.innerHTML = `
        <div class="empty">
          Live webresultaten zijn niet geconfigureerd. 
          Vul in <strong>Instellingen → Google Custom Search API</strong> een API-key en CSE-ID in.
        </div>`;
      return;
    }

    let q = query || "HACCP logistiek magazijn";
    if (searchTopicFilter === "HACCP") {
      q += " HACCP food safety logistics warehousing";
    } else if (searchTopicFilter === "BVP") {
      q += " warehouse best practices hygiene temperature";
    } else if (searchTopicFilter === "FAVV") {
      q += " site:favv-afsca.be traceerbaarheid temperatuur voedselveiligheid";
    } else if (searchTopicFilter === "IFS") {
      q += " \"IFS Logistics\" audit traceability";
    }

    const url = `https://www.googleapis.com/customsearch/v1?key=${encodeURIComponent(apiKey)}&cx=${encodeURIComponent(cx)}&q=${encodeURIComponent(q)}`;

    webResultsEl.innerHTML = `<div class="empty">Webresultaten worden opgehaald…</div>`;
    try {
      const resp = await fetch(url);
      if (!resp.ok) throw new Error("HTTP " + resp.status);
      const data = await resp.json();
      const items = data.items || [];
      if (!items.length) {
        webResultsEl.innerHTML = `<div class="empty">Geen webresultaten gevonden.</div>`;
        return;
      }

      webResultsEl.innerHTML = items.map(item => `
        <article class="result-card">
          <div class="result-header">
            <div class="result-title">
              <a href="${item.link}" target="_blank" rel="noopener noreferrer">
                ${item.title || "Resultaat"}
              </a>
            </div>
            <span class="result-badge">Web</span>
          </div>
          <div class="result-url">${item.displayLink || ""}</div>
          <div class="result-snippet">${item.snippet || ""}</div>
        </article>
      `).join("");
    } catch (e) {
      console.error(e);
      webResultsEl.innerHTML = `<div class="error">Fout bij het ophalen van webresultaten. Controleer API-key, CSE-ID en internetverbinding.</div>`;
    }
  }

  function performSearch(includeWeb = true) {
    const keyword = (searchInputEl.value || "").trim();
    const internal = filterKnowledge(keyword, searchTopicFilter);
    renderInternal(internal);

    searchStat.count += 1;
    searchStat.lastQuery = keyword || "(leeg)";
    saveJson(STORAGE_SEARCHSTAT, searchStat);

    const countLabel = internal.length === 1
      ? "1 intern resultaat"
      : `${internal.length} interne resultaten`;

    searchStatusEl.textContent = `Zoekopdracht uitgevoerd. ${countLabel}.`;

    updateDashboard();
    updateSidebarStats();

    if (includeWeb) {
      fetchWebResults(keyword);
    }
  }

  if (searchBtnEl) {
    searchBtnEl.addEventListener("click", () => performSearch(true));
  }

  if (searchInputEl) {
    searchInputEl.addEventListener("keydown", e => {
      if (e.key === "Enter") {
        e.preventDefault();
        performSearch(true);
      }
    });
  }

  /******** TRAINING ********/

  const trainingFormEl   = document.getElementById("trainingForm");
  const trainingTableEl  = document.getElementById("trainingTable");
  const btnExportTraining = document.getElementById("btnExportTraining");

  function renderTrainingTable() {
    if (!trainings.length) {
      trainingTableEl.innerHTML = `<div class="empty">Nog geen registraties. Gebruik het formulier hierboven om een eerste training of toolbox te loggen.</div>`;
      return;
    }

    const rows = trainings
      .slice()
      .sort((a, b) => (b.date || "").localeCompare(a.date || ""))
      .map(rec => {
        const cls = rec.status === "afgerond" ? "done" : "open";
        const lbl = rec.status === "afgerond" ? "Afgerond" : "Nog te vervolledigen";
        return `
          <tr>
            <td>${rec.date || ""}</td>
            <td>${rec.employee || ""}</td>
            <td>${rec.topic || ""}</td>
            <td>${rec.type || ""}</td>
            <td>${rec.notes || ""}</td>
            <td class="text-right">
              <span class="pill-status ${cls}">${lbl}</span>
            </td>
          </tr>
        `;
      }).join("");

    trainingTableEl.innerHTML = `
      <div style="max-height:260px; overflow:auto;">
        <table>
          <thead>
            <tr>
              <th>Datum</th>
              <th>Medewerker</th>
              <th>Domein</th>
              <th>Type</th>
              <th>Inhoud / bijzonderheden</th>
              <th class="text-right">Status</th>
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>
      </div>
    `;
  }

  if (trainingFormEl) {
    trainingFormEl.addEventListener("submit", e => {
      e.preventDefault();
      const employee = document.getElementById("trEmployee").value.trim();
      const topic    = document.getElementById("trTopic").value;
      const date     = document.getElementById("trDate").value;
      const type     = document.getElementById("trType").value.trim();
      const notes    = document.getElementById("trNotes").value.trim();
      const status   = document.getElementById("trStatus").value;

      if (!employee || !topic || !date) {
        alert("Vul minstens medewerker, domein en datum in.");
        return;
      }

      trainings.push({
        id: "TR-" + Date.now(),
        employee, topic, date, type, notes, status
      });
      saveJson(STORAGE_TRAINING, trainings);
      renderTrainingTable();
      updateDashboard();
      trainingFormEl.reset();
    });
  }

  if (btnExportTraining) {
    btnExportTraining.addEventListener("click", () => {
      if (!trainings.length) {
        alert("Er zijn nog geen registraties om te exporteren.");
        return;
      }
      const blob = new Blob([JSON.stringify(trainings, null, 2)], { type: "application/json" });
      const url  = URL.createObjectURL(blob);
      const a    = document.createElement("a");
      a.href = url;
      a.download = "foodsafety_training_registrations.json";
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    });
  }

  /******** SETTINGS & BRANDING ********/

  const brandTitleEl    = document.getElementById("brandTitle");
  const brandSubEl      = document.getElementById("brandSubtitle");
  const setBrandNameEl  = document.getElementById("setBrandName");
  const setBrandSubEl   = document.getElementById("setBrandSub");
  const setApiKeyEl     = document.getElementById("setApiKey");
  const setCxEl         = document.getElementById("setCx");
  const btnSaveBrand    = document.getElementById("btnSaveBrand");
  const btnSaveApi      = document.getElementById("btnSaveApi");
  const btnClearAll     = document.getElementById("btnClearAll");

  function applyBranding() {
    brandTitleEl.textContent = settings.brandName || "FoodSafety Navigator";
    brandSubEl.textContent   = settings.brandSub  || "HACCP · BVP · FAVV · IFS Logistics – praktijk & compliance";
  }

  function loadSettingsForm() {
    setBrandNameEl.value = settings.brandName || "";
    setBrandSubEl.value  = settings.brandSub  || "";
    setApiKeyEl.value    = settings.apiKey   || "";
    setCxEl.value        = settings.cx       || "";
  }

  if (btnSaveBrand) {
    btnSaveBrand.addEventListener("click", () => {
      settings.brandName = setBrandNameEl.value.trim() || "FoodSafety Navigator";
      settings.brandSub  = setBrandSubEl.value.trim()  || "HACCP · BVP · FAVV · IFS Logistics – praktijk & compliance";
      saveJson(STORAGE_SETTINGS, settings);
      applyBranding();
      alert("Branding opgeslagen.");
    });
  }

  if (btnSaveApi) {
    btnSaveApi.addEventListener("click", () => {
      settings.apiKey = setApiKeyEl.value.trim();
      settings.cx     = setCxEl.value.trim();
      saveJson(STORAGE_SETTINGS, settings);
      alert("API-instellingen opgeslagen. Webresultaten in de zoekmachine zijn nu actief.");
    });
  }

  if (btnClearAll) {
    btnClearAll.addEventListener("click", () => {
      if (!confirm("Dit wist ALLE lokale data (voortgang, trainingen, instellingen). Doorgaan?")) return;
      localStorage.removeItem(STORAGE_PROGRESS);
      localStorage.removeItem(STORAGE_TRAINING);
      localStorage.removeItem(STORAGE_SETTINGS);
      localStorage.removeItem(STORAGE_SEARCHSTAT);
      location.reload();
    });
  }

  /******** DASHBOARD & SIDEBAR ********/

  const dashLessonsEl  = document.getElementById("dashLessons");
  const dashTrainingEl = document.getElementById("dashTraining");
  const dashSearchEl   = document.getElementById("dashSearch");
  const btnGotoLearn   = document.getElementById("btnGotoLearn");

  if (btnGotoLearn) {
    btnGotoLearn.addEventListener("click", () => showView("view-learn"));
  }

  function updateDashboard() {
    const total = LESSONS.length;
    let doneLessons = 0;
    LESSONS.forEach(lesson => {
      const prog = getLessonProgress(lesson.id);
      if ((prog.doneSteps || []).length === lesson.steps.length && lesson.steps.length > 0) {
        doneLessons++;
      }
    });
    dashLessonsEl.textContent =
      total ? `Je hebt ${doneLessons} van de ${total} HACCP-lessen volledig afgerond.` :
              "Nog geen lessen geconfigureerd.";

    if (!trainings.length) {
      dashTrainingEl.textContent = "Nog geen trainingsregistraties.";
    } else {
      const last = trainings.slice().sort((a,b) => (b.date || "").localeCompare(a.date || ""))[0];
      const statusLabel = last.status === "afgerond" ? "afgerond" : "nog open";
      dashTrainingEl.textContent =
        `Laatste registratie: ${last.employee} – ${last.topic} op ${last.date} (${statusLabel}).`;
    }

    if (!searchStat.count) {
      dashSearchEl.textContent = "Nog geen zoekopdrachten uitgevoerd.";
    } else {
      dashSearchEl.textContent =
        `${searchStat.count} zoekopdrachten uitgevoerd. Laatste term: “${searchStat.lastQuery}”.`;
    }
  }

  function updateSidebarStats() {
    const totalLessons = LESSONS.length;
    let doneLessons = 0;
    LESSONS.forEach(lesson => {
      const prog = getLessonProgress(lesson.id);
      if ((prog.doneSteps || []).length === lesson.steps.length && lesson.steps.length > 0) {
        doneLessons++;
      }
    });

    const totalTrainings = trainings.length;
    const searches       = searchStat.count || 0;

    sidebarStats.innerHTML = `
      <div><strong>${doneLessons}/${totalLessons}</strong> HACCP-lessen afgerond</div>
      <div><strong>${totalTrainings}</strong> trainingsregistraties</div>
      <div><strong>${searches}</strong> zoekopdrachten</div>
    `;
  }

  /******** INIT ********/

  function init() {
    applyBranding();
    loadSettingsForm();
    renderLessonList();
    renderLessonDetail();
    renderTrainingTable();
    updateDashboard();
    updateSidebarStats();
    updateSearchMeta();
  }

  init();
</script>
</body>
</html>
