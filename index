<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8">
  <title>FoodSafety Navigator – HACCP · BVP · FAVV · IFS Logistics</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <style>
    :root {
      --bg: #020617;
      --bg-soft: #020617;
      --panel: #020617;
      --panel-alt: #0b1220;
      --accent: #22c55e;
      --accent-soft: rgba(34,197,94,0.16);
      --accent-strong: rgba(34,197,94,0.26);
      --border: #1e293b;
      --text: #e5e7eb;
      --text-soft: #9ca3af;
      --danger: #f97373;
      --radius-lg: 1rem;
      --radius-xl: 1.6rem;
      --shadow-soft: 0 22px 55px rgba(15,23,42,0.9);
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
      background: radial-gradient(circle at top, #111827 0, #020617 50%, #000 100%);
      color: var(--text);
    }

    a {
      color: var(--accent);
    }

    .app {
      max-width: 1120px;
      margin: 1.75rem auto 2.75rem;
      padding: 0 1.25rem;
    }

    header.app-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
      margin-bottom: 1.25rem;
    }

    @media (max-width: 720px) {
      header.app-header {
        flex-direction: column;
        align-items: flex-start;
      }
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .brand-logo {
      width: 40px;
      height: 40px;
      border-radius: 1.2rem;
      background: radial-gradient(circle at 30% 20%, #bbf7d0, #22c55e 45%, #16a34a 70%, #14532d 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #022c22;
      font-weight: 800;
      font-size: 1.1rem;
      box-shadow: 0 16px 36px rgba(16,185,129,0.55);
    }

    .brand-text h1 {
      margin: 0;
      font-size: 1.4rem;
    }

    .brand-text small {
      display: block;
      font-size: 0.8rem;
      color: var(--text-soft);
      margin-top: 0.1rem;
    }

    .status-pill {
      display: inline-flex;
      align-items: center;
      gap: 0.45rem;
      border-radius: 999px;
      border: 1px solid var(--accent);
      background: rgba(34,197,94,0.08);
      padding: 0.25rem 0.8rem;
      font-size: 0.75rem;
      text-transform: uppercase;
      letter-spacing: 0.11em;
      color: var(--accent);
    }

    .status-pill span.dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #4ade80;
      box-shadow: 0 0 10px rgba(74,222,128,0.9);
    }

    .layout {
      display: grid;
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 1.25rem;
      align-items: flex-start;
    }

    @media (max-width: 900px) {
      .layout {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .panel {
      background:
        radial-gradient(circle at top left, rgba(34,197,94,0.08), transparent 65%),
        linear-gradient(to bottom right, rgba(15,23,42,0.98), rgba(15,23,42,1));
      border-radius: var(--radius-xl);
      border: 1px solid rgba(148,163,184,0.3);
      padding: 1rem 1.1rem;
      box-shadow: var(--shadow-soft);
      backdrop-filter: blur(18px);
    }

    .panel h2 {
      margin: 0 0 0.55rem;
      font-size: 1rem;
      display: flex;
      align-items: center;
      gap: 0.45rem;
    }

    .panel h2 .icon {
      font-size: 1.15rem;
    }

    .panel small {
      color: var(--text-soft);
      font-size: 0.78rem;
    }

    .sidebar-title {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.15em;
      color: var(--text-soft);
      margin: 0.1rem 0 0.35rem;
    }

    .nav-list {
      display: flex;
      flex-direction: column;
      gap: 0.3rem;
      margin-bottom: 0.9rem;
    }

    .nav-btn {
      width: 100%;
      border-radius: 0.9rem;
      border: 1px solid rgba(30,64,175,0.5);
      background: rgba(15,23,42,0.96);
      padding: 0.45rem 0.7rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.4rem;
      cursor: pointer;
      font-size: 0.8rem;
      color: var(--text-soft);
      transition: background 0.15s ease-out,
                  border 0.15s ease-out,
                  color 0.15s ease-out,
                  transform 0.05s ease-out,
                  box-shadow 0.15s ease-out;
    }

    .nav-btn-left {
      display: flex;
      align-items: center;
      gap: 0.4rem;
    }

    .nav-btn-icon {
      font-size: 0.95rem;
    }

    .nav-btn-meta {
      font-size: 0.68rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .nav-btn.active {
      border-color: var(--accent);
      background: var(--accent-soft);
      color: var(--accent);
      transform: translateY(-1px);
      box-shadow: 0 12px 30px rgba(15,23,42,1);
    }

    .nav-btn:hover {
      border-color: rgba(59,130,246,0.9);
    }

    .sidebar-stats {
      margin-top: 0.4rem;
      border-radius: 0.9rem;
      border: 1px dashed rgba(148,163,184,0.6);
      background: rgba(15,23,42,0.96);
      padding: 0.55rem 0.6rem;
      font-size: 0.78rem;
      color: var(--text-soft);
    }

    .sidebar-stats strong {
      color: #bbf7d0;
    }

    .view {
      display: none;
    }
    .view.active {
      display: block;
    }

    .two-col {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      gap: 1rem;
      margin-top: 0.7rem;
    }

    @media (max-width: 900px) {
      .two-col {
        grid-template-columns: minmax(0, 1fr);
      }
    }

    .section-title {
      font-size: 0.92rem;
      font-weight: 600;
      margin-bottom: 0.3rem;
    }

    .muted {
      font-size: 0.8rem;
      color: var(--text-soft);
    }

    .btn {
      border-radius: 999px;
      border: 1px solid var(--accent);
      background: var(--accent-soft);
      color: var(--accent);
      padding: 0.38rem 0.9rem;
      font-size: 0.78rem;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      cursor: pointer;
      transition: background 0.15s ease-out,
                  box-shadow 0.15s ease-out,
                  transform 0.05s ease-out;
    }

    .btn:hover {
      background: var(--accent-strong);
      transform: translateY(-1px);
      box-shadow: 0 12px 30px rgba(15,23,42,0.95);
    }

    .btn.secondary {
      border-color: rgba(148,163,184,0.7);
      background: rgba(15,23,42,0.98);
      color: var(--text-soft);
    }

    .btn.danger {
      border-color: rgba(248,113,113,0.9);
      background: rgba(239,68,68,0.12);
      color: #fecaca;
    }

    input[type="text"],
    input[type="date"],
    input[type="password"],
    textarea,
    select {
      width: 100%;
      padding: 0.46rem 0.65rem;
      border-radius: 0.7rem;
      border: 1px solid rgba(148,163,184,0.4);
      background: rgba(15,23,42,0.98);
      color: var(--text);
      font-size: 0.85rem;
      outline: none;
      transition: border 0.15s ease-out,
                  box-shadow 0.15s ease-out,
                  background 0.15s ease-out;
    }

    input:focus,
    textarea:focus,
    select:focus {
      border-color: var(--accent);
      box-shadow: 0 0 0 1px rgba(34,197,94,0.4);
      background: rgba(15,23,42,1);
    }

    textarea {
      resize: vertical;
      min-height: 70px;
    }

    .field-group {
      margin-bottom: 0.7rem;
    }

    .field-label {
      font-size: 0.8rem;
      margin-bottom: 0.25rem;
      display: flex;
      justify-content: space-between;
      gap: 0.5rem;
    }

    .field-label span.meta {
      font-size: 0.7rem;
      color: var(--text-soft);
    }

    .hint {
      font-size: 0.75rem;
      color: var(--text-soft);
      margin-top: 0.18rem;
    }

    .tag {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      border: 1px solid rgba(148,163,184,0.6);
      padding: 0.12rem 0.5rem;
      font-size: 0.7rem;
      color: var(--text-soft);
    }

    .tag.topic {
      border-color: var(--accent);
      color: var(--accent);
      background: rgba(34,197,94,0.12);
      text-transform: uppercase;
      letter-spacing: 0.07em;
    }

    .badge-level {
      display: inline-flex;
      align-items: center;
      border-radius: 999px;
      border: 1px solid rgba(148,163,184,0.7);
      padding: 0.12rem 0.5rem;
      font-size: 0.7rem;
      color: var(--text-soft);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .empty {
      font-size: 0.8rem;
      color: var(--text-soft);
      margin-top: 0.35rem;
    }

    .error {
      font-size: 0.8rem;
      color: var(--danger);
      margin-top: 0.35rem;
    }

    .lesson-list {
      display: flex;
      flex-direction: column;
      gap: 0.45rem;
    }

    .lesson-card {
      border-radius: 0.9rem;
      border: 1px solid rgba(51,65,85,0.9);
      background: rgba(15,23,42,0.98);
      padding: 0.55rem 0.65rem;
      cursor: pointer;
      transition: background 0.15s ease-out,
                  border 0.15s ease-out,
                  transform 0.05s ease-out;
    }

    .lesson-card:hover {
      border-color: rgba(59,130,246,0.9);
      transform: translateY(-1px);
    }

    .lesson-card.active {
      border-color: var(--accent);
      background:
        radial-gradient(circle at top left, rgba(34,197,94,0.16), transparent 65%),
        rgba(15,23,42,1);
    }

    .lesson-card-title {
      font-size: 0.9rem;
      font-weight: 600;
      margin-bottom: 0.12rem;
    }

    .lesson-card-meta {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.35rem;
      font-size: 0.75rem;
      color: var(--text-soft);
    }

    .progress-dot {
      width: 9px;
      height: 9px;
      border-radius: 50%;
      border: 1px solid rgba(148,163,184,0.5);
    }

    .progress-dot.partial {
      border-color: #eab308;
      background: #eab308;
    }

    .progress-dot.done {
      border-color: var(--accent);
      background: var(--accent);
    }

    .step-check {
      display: flex;
      align-items: flex-start;
      gap: 0.45rem;
      margin-bottom: 0.33rem;
      font-size: 0.83rem;
    }

    .step-check input[type="checkbox"] {
      margin-top: 0.18rem;
      accent-color: var(--accent);
    }

    .search-row {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 0.6rem;
    }

    .search-row input[type="text"] {
      flex: 1;
    }

    .chip {
      border-radius: 999px;
      border: 1px solid rgba(148,163,184,0.6);
      padding: 0.18rem 0.55rem;
      font-size: 0.74rem;
      cursor: pointer;
      background: rgba(15,23,42,0.96);
      color: var(--text-soft);
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      transition: border 0.15s ease-out,
                  background 0.15s ease-out,
                  color 0.15s ease-out;
    }

    .chip.active {
      border-color: var(--accent);
      background: var(--accent-soft);
      color: var(--accent);
    }

    .results-meta {
      display: flex;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.5rem;
      font-size: 0.78rem;
      color: var(--text-soft);
      margin-bottom: 0.4rem;
    }

    .result-card {
      border-radius: 0.9rem;
      border: 1px solid rgba(51,65,85,0.9);
      background: rgba(15,23,42,1);
      padding: 0.5rem 0.6rem;
      margin-bottom: 0.4rem;
      font-size: 0.8rem;
    }

    .result-header {
      display: flex;
      justify-content: space-between;
      gap: 0.4rem;
      align-items: center;
      margin-bottom: 0.1rem;
    }

    .result-title {
      font-size: 0.84rem;
      font-weight: 600;
    }

    .result-title a {
      text-decoration: none;
      color: var(--accent);
    }

    .result-title a:hover {
      text-decoration: underline;
    }

    .result-url {
      font-size: 0.7rem;
      color: #6ee7b7;
      margin-bottom: 0.12rem;
      word-break: break-all;
    }

    .result-snippet {
      font-size: 0.78rem;
      color: var(--text-soft);
    }

    .result-badge {
      font-size: 0.7rem;
      border-radius: 999px;
      border: 1px solid rgba(148,163,184,0.7);
      padding: 0.1rem 0.45rem;
      color: var(--text-soft);
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.78rem;
    }

    th, td {
      padding: 0.4rem 0.45rem;
      border-bottom: 1px solid rgba(51,65,85,0.95);
    }

    th {
      text-align: left;
      font-weight: 500;
      color: var(--text-soft);
      background: rgba(15,23,42,0.98);
      position: sticky;
      top: 0;
    }

    .text-right {
      text-align: right;
    }

    .pill-status {
      font-size: 0.7rem;
      padding: 0.08rem 0.55rem;
      border-radius: 999px;
      border: 1px solid rgba(148,163,184,0.7);
    }

    .pill-status.done {
      border-color: var(--accent);
      color: var(--accent);
      background: rgba(34,197,94,0.14);
    }

    .pill-status.open {
      border-color: #fb923c;
      color: #fed7aa;
      background: rgba(249,115,22,0.18);
    }

    .footnote {
      margin-top: 0.9rem;
      font-size: 0.7rem;
      color: var(--text-soft);
      max-width: 820px;
    }

    .lesson-theory h3,
    .lesson-theory h4 {
      margin: 0.35rem 0 0.25rem;
      font-size: 0.9rem;
    }

    .lesson-theory p {
      margin: 0.1rem 0 0.35rem;
      font-size: 0.83rem;
      color: var(--text-soft);
    }

    .lesson-theory ul {
      margin: 0.1rem 0 0.35rem 1.15rem;
      padding: 0;
      font-size: 0.83rem;
      color: var(--text-soft);
    }
  </style>
</head>

<body>
<div class="app">
  <header class="app-header" aria-label="Kop">
    <div class="brand">
      <div class="brand-logo" aria-hidden="true">FS</div>
      <div class="brand-text">
        <h1 id="brandTitle">FoodSafety Navigator</h1>
        <small id="brandSubtitle">HACCP · BVP · FAVV · IFS Logistics – praktijk &amp; compliance</small>
      </div>
    </div>
    <div class="status-pill" aria-label="Status">
      <span class="dot"></span>
      Live kennis &amp; opleiding
    </div>
  </header>

  <main class="layout">
    <aside class="panel" aria-label="Navigatie">
      <h2><span class="icon">📌</span> Navigatie</h2>

      <div class="sidebar-title">Hoofdmodules</div>
      <nav class="nav-list">
        <button class="nav-btn active" data-view="view-dashboard">
          <div class="nav-btn-left">
            <span class="nav-btn-icon">📊</span>
            <div>
              <div>Dashboard</div>
              <div class="nav-btn-meta">Overzicht &amp; voortgang</div>
            </div>
          </div>
        </button>

        <button class="nav-btn" data-view="view-learn">
          <div class="nav-btn-left">
            <span class="nav-btn-icon">🎓</span>
            <div>
              <div>HACCP-leerpad</div>
              <div class="nav-btn-meta">Theorie &amp; stappen</div>
            </div>
          </div>
        </button>

        <button class="nav-btn" data-view="view-search">
          <div class="nav-btn-left">
            <span class="nav-btn-icon">🔍</span>
            <div>
              <div>Kennis &amp; zoekmachine</div>
              <div class="nav-btn-meta">HACCP · BVP · FAVV · IFS</div>
            </div>
          </div>
        </button>

        <button class="nav-btn" data-view="view-training">
          <div class="nav-btn-left">
            <span class="nav-btn-icon">✅</span>
            <div>
              <div>Training &amp; registraties</div>
              <div class="nav-btn-meta">Audit-ready logging</div>
            </div>
          </div>
        </button>

        <button class="nav-btn" data-view="view-settings">
          <div class="nav-btn-left">
            <span class="nav-btn-icon">⚙️</span>
            <div>
              <div>Instellingen</div>
              <div class="nav-btn-meta">Branding &amp; API</div>
            </div>
          </div>
        </button>
      </nav>

      <div class="sidebar-title">Vandaag</div>
      <div class="sidebar-stats" id="sidebarStats">Laden...</div>
    </aside>

    <section aria-label="Hoofdinhoud">
      <section class="panel view active" id="view-dashboard">
        <h2><span class="icon">📊</span> Dashboard</h2>
        <small>Overzicht van je HACCP-leerpad, trainingen en zoekactiviteit.</small>

        <div class="two-col">
          <div>
            <div class="section-title">Voortgang HACCP-leerpad</div>
            <p class="muted" id="dashLessons">-</p>
            <button class="btn secondary" id="btnGotoLearn">Ga naar HACCP-leerpad</button>
          </div>
          <div>
            <div class="section-title">Training &amp; zoekactiviteit</div>
            <p class="muted" id="dashTraining">-</p>
            <p class="muted" id="dashSearch">-</p>
          </div>
        </div>
      </section>

      <section class="panel view" id="view-learn">
        <h2><span class="icon">🎓</span> HACCP-leerpad</h2>
        <small>Volledige theorie in gewone mensentaal + afvinkbare acties. Zonder dat je zelf moet gaan zoeken.</small>

        <div class="two-col">
          <div>
            <div class="lesson-list" id="lessonList"></div>
          </div>
          <div id="lessonDetail">
            <p class="muted">
              Kies links een les. Bij elke les krijg je eerst de theorie (HACCP uitgelegd),
              daarna concrete acties die je kan afvinken. De zoekmachine is enkel voor extra verdieping.
            </p>
          </div>
        </div>
      </section>

      <section class="panel view" id="view-search">
        <h2><span class="icon">🔍</span> Kennis &amp; zoekmachine</h2>
        <small>Interne kennisbank (HACCP, BVP, FAVV, IFS Logistics) + optionele live webresultaten.</small>

        <div style="margin-top:0.7rem;">
          <div class="search-row">
            <input id="searchInput" type="text"
                   placeholder="Zoek bv. 'HACCP gevarenanalyse', 'FAVV traceerbaarheid', 'IFS hoofdstukken'…">
            <button class="btn secondary" id="searchBtn">Zoek</button>
          </div>

          <div class="search-row">
            <span class="chip active" data-topic="ALL">Alle domeinen</span>
            <span class="chip" data-topic="HACCP">HACCP</span>
            <span class="chip" data-topic="BVP">BVP / logistiek</span>
            <span class="chip" data-topic="FAVV">FAVV / wetgeving</span>
            <span class="chip" data-topic="IFS">IFS Logistics</span>
          </div>

          <div class="results-meta">
            <span id="searchStatus">Nog geen zoekopdracht.</span>
            <span id="searchMeta">Filter: alle domeinen</span>
          </div>

          <div class="two-col">
            <div>
              <div class="section-title">Interne kennisbank</div>
              <div id="internalResults"></div>
            </div>
            <div>
              <div class="section-title">Live webresultaten</div>
              <div id="webResults"></div>
            </div>
          </div>
        </div>
      </section>

      <section class="panel view" id="view-training">
        <h2><span class="icon">✅</span> Training &amp; registraties</h2>
        <small>Log opleidingen, toolboxen en uitleg voor medewerkers. Alles blijft lokaal bewaard.</small>

        <div style="margin-top:0.7rem;">
          <form id="trainingForm">
            <div class="two-col">
              <div>
                <div class="field-group">
                  <label class="field-label" for="trEmployee">
                    Medewerker
                    <span class="meta">verplicht</span>
                  </label>
                  <input id="trEmployee" type="text" required placeholder="Naam medewerker">
                </div>

                <div class="field-group">
                  <label class="field-label" for="trTopic">
                    Domein
                    <span class="meta">HACCP / BVP / FAVV / IFS</span>
                  </label>
                  <select id="trTopic" required>
                    <option value="">Kies een domein…</option>
                    <option value="HACCP">HACCP</option>
                    <option value="BVP">BVP – logistieke best practices</option>
                    <option value="FAVV">FAVV / wetgeving</option>
                    <option value="IFS">IFS Logistics / kwaliteitsmanagement</option>
                  </select>
                </div>

                <div class="field-group">
                  <label class="field-label" for="trDate">
                    Datum
                    <span class="meta">verplicht</span>
                  </label>
                  <input id="trDate" type="date" required>
                </div>
              </div>

              <div>
                <div class="field-group">
                  <label class="field-label" for="trType">
                    Type / context
                    <span class="meta">optioneel</span>
                  </label>
                  <input id="trType" type="text"
                         placeholder="bv. onboarding, toolbox, refresh, auditvoorbereiding">
                </div>

                <div class="field-group">
                  <label class="field-label" for="trNotes">
                    Inhoud / bijzonderheden
                    <span class="meta">korte samenvatting</span>
                  </label>
                  <textarea id="trNotes"
